@{
    ViewData["Title"] = "AI Chat";
}

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: Arial, sans-serif;
    }

    .chat-wrapper {
        max-width: 900px;
        margin: auto;
        height: 100vh;
        display: flex;
        flex-direction: column;
        margin-bottom: 45px;
    }

    .chat-header {
        padding: 20px;
        background: white;
        border-bottom: 1px solid #ddd;
        font-size: 20px;
        font-weight: bold;
    }

    .chat-box {
        overflow-y: auto;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .message {
        max-width: 80%;
        padding: 12px 16px;
        border-radius: 12px;
        line-height: 1.5;
        word-wrap: break-word;
    }
    .message p{
        padding:0;
        margin:0;
    }

    .user {
        align-self: flex-end;
        background: #2563eb;
        color: white;
    }

    .assistant {
        align-self: flex-start;
        background: white;
        border: 1px solid #ddd;
    }

    .chat-input-area {
        display: flex;
        gap: 10px;
        padding: 20px;
        background: white;
        border-top: 1px solid #ddd;
    }

    .chat-input {
        flex: 1;
        padding: 14px;
        border: 1px solid #ccc;
        border-radius: 10px;
        outline: none;
        font-size: 16px;
    }

        .chat-input:focus {
            border-color: #2563eb;
        }

    .btn {
        border: none;
        padding: 0 18px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 15px;
    }

    .send-btn {
        background: #2563eb;
        color: white;
    }

    .voice-btn {
        background: #444;
        color: white;
    }

    .typing {
        padding: 0 20px 10px 20px;
        color: gray;
        font-size: 14px;
        display: none;
    }

    pre {
        background: #1e1e1e;
        color: white;
        padding: 12px;
        border-radius: 8px;
        overflow-x: auto;
    }

    code {
        font-family: Consolas, monospace;
    }

</style>

<div class="chat-wrapper">

    <div id="chatBox"
         class="chat-box">
    </div>

    <div id="typing"
         class="typing">
        Assistant is typing...
    </div>

    <div class="chat-input-area">

        <input id="messageInput"
               class="chat-input"
               placeholder="Type a message..." />

        <button class="btn send-btn"
                onclick="sendMessage()">
            Send
        </button>

        <button class="btn voice-btn"
                onclick="startVoice()">
            🎤
        </button>

    </div>

</div>

<script>

    const chatBox =
        document.getElementById("chatBox");


    // =======================================
    // Send Message
    // =======================================

    async function sendMessage() {

        const input = document.getElementById("messageInput");

        const message = input.value.trim();

        if (!message)
            return;

        appendMessage("user", message);

        input.value = "";

        showTyping(true);

        try {

            const response = await fetch("/api/chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    message: message
                })
            });

            const data = await response.json();

            appendMessage("assistant", formatMessage(data.reply));

        }
        catch (error) {

            appendMessage("assistant", "Error: " + error.message);
        }

        showTyping(false);
    }


    // =======================================
    // Append Message
    // =======================================

    function appendMessage(role, message) {

        const div = document.createElement("div");

        div.className = `message ${role}`;
        
        // const messageHtml = message.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
        // div.innerHTML = messageHtml;
        
        div.innerHTML = marked.parse(message);

        chatBox.appendChild(div);

        chatBox.scrollTop = chatBox.scrollHeight;
    }


    // =======================================
    // Minimal Formatting
    // =======================================

    function formatMessage(text) {

        // Escape HTML
        text = text
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");

        // Code blocks
        text = text.replace(
            /```([\s\S]*?)```/g,
            '<pre><code>$1</code></pre>');

        // Line breaks
        text = text.replace(/\n/g, "<br>");

        return text;
    }


    // =======================================
    // Typing Indicator
    // =======================================

    function showTyping(show) {

        document.getElementById("typing")
            .style.display =
            show ? "block" : "none";
    }


    // =======================================
    // Enter Key
    // =======================================

    document.getElementById("messageInput")
        .addEventListener("keypress",
        function(e) {

            if (e.key === "Enter") {

                sendMessage();
            }
        });


    // =======================================
    // Voice Input
    // =======================================

    // function startVoice() {

    //     if (!('webkitSpeechRecognition' in window)) {

    //         alert("Voice recognition not supported.");

    //         return;
    //     }

    //     const recognition = new webkitSpeechRecognition();

    //     recognition.lang = "en-US";

    //     recognition.start();

    //     recognition.onresult = function(event) {

    //         const transcript =
    //             event.results[0][0].transcript;

    //         document.getElementById(
    //             "messageInput").value =
    //             transcript;
    //     };
    // }

        function startVoice() {

        if (!('webkitSpeechRecognition' in window)) {
            alert("Voice recognition not supported.");
            return;
        }

        const SpeechRecognition =
            window.SpeechRecognition || window.webkitSpeechRecognition;

        const recognition = new SpeechRecognition();

        recognition.continuous = false;
        recognition.interimResults = false;

        // Start with default language
        recognition.lang = "en-IN";

        recognition.start();

        recognition.onresult = async function(event) {

            const transcript =
                event.results[0][0].transcript;

            // Detect language
            const detectedLang =
                detectLanguage(transcript);

            console.log("Detected Language:", detectedLang);

            // Set detected language
            recognition.lang = detectedLang;

            document.getElementById("messageInput").value =
                transcript;
        };

        recognition.onerror = function(event) {
            console.error("Speech recognition error:", event.error);
        };
    }


    // Simple language detection
    function detectLanguage(text) {

        // Hindi Unicode range
        const hindiRegex = /[\u0900-\u097F]/;

        // Gujarati Unicode range
        const gujaratiRegex = /[\u0A80-\u0AFF]/;

        if (gujaratiRegex.test(text)) {
            return "gu-IN";
        }

        if (hindiRegex.test(text)) {
            return "hi-IN";
        }

        // Default English
        return "en-IN";
    }

</script>